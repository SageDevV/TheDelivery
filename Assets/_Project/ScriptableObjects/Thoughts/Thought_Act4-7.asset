  lines:
  - text: "[Atendente] \"Emerg\xEAncia, qual a sua emerg\xEAncia?\""
    duration: 2.5
    delay: 2
  - text: "Tem algu\xE9m dentro da minha casa. Por favor."
    duration: 2.5
    delay: 2
  - text: "[Atendente] \"Certo, mantenha a calma. Qual o seu endere\xE7o?\""
    duration: 2.5
    delay: 2
  - text: "[Atendente] \"Certo, mantenha a calma. Qual o seu endere\xE7o?\""
    duration: 2.5
    delay: 2
  - text: "Rua [...], apartamento [...]. Ele est\xE1 aqui. Eu vi ele."
    duration: 2.5
    delay: 2
  - text: "[Atendente] \"J\xE1 estou enviando uma viatura. Voc\xEA consegue se manter
      em seguran\xE7a?\""
    duration: 0
    delay: 2
  - text: Eu... eu vou tentar.
    duration: 0
    delay: 2
  - text: "[Atendente] \"Fique na linha comigo. A viatura est\xE1 a caminho, est\xE1
      me ouvindo? Est\xE1\u2014\""
    duration: 0
    delay: 2
