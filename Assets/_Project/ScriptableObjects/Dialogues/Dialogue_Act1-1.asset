  m_Script: {fileID: 11500000, guid: a5dff2e1582e6f4458683d70c6288f41, type: 3}
  m_Name: Dialogue_Act1-1
  m_EditorClassIdentifier: Assembly-CSharp::TheDelivery.Narrative.DialogueData
  lines:
  - speaker: Marina
    text: "Oi! Desculpa o atraso, o \xF4nibus demorou uma eternidade."
    extraHold: 0
  - speaker: "Voc\xEA (Clear)"
    text: "Tranquilo. Tava s\xF3 revisando pra prova de algoritmos. Acabei cochilando."
    extraHold: 0
  - speaker: Marina
    text: "Aquela prova vai ser um massacre. Voc\xEA entendeu recurs\xE3o?"
    extraHold: 0
  - speaker: "Voc\xEA (Clear)"
    text: "Mais ou menos. As \xE1rvores bin\xE1rias ainda me confundem."
    extraHold: 0
  - speaker: Marina
    text: Relaxa, a gente revisa junto no fim de semana.
    extraHold: 0
  - speaker: "Voc\xEA (Clear)"
    text: "Fechado. Obrigada por vir at\xE9 aqui."
    extraHold: 0
  - speaker: Marina
    text: "Imagina! Preciso ir agora, mas a gente se fala. Se cuida, t\xE1"
    extraHold: 0
