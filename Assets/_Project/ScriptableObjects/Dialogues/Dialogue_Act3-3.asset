  lines:
  - speaker: "Voc\xEA"
    text: "Com licen\xE7a? Desculpa incomodar... "
    extraHold: 0
    sfx: {fileID: 0}
  - speaker: Vizinho
    text: "Que horas s\xE3o pra ficar batendo na porta dos outros?"
    extraHold: 0
    sfx: {fileID: 0}
  - speaker: "Voc\xEA"
    text: "Desculpa, \xE9 que t\xE1 acontecendo umas coisas estranhas e eu\u2014"
    extraHold: 0
    sfx: {fileID: 0}
  - speaker: Vizinho
    text: "Estranho \xE9 voc\xEA. Some daqui. Deixa eu jogar meu Valorant!"
    extraHold: 0
    sfx: {fileID: 0}
